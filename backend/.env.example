# ==============================================================================
# CodeSentinel Backend Configuration
#
# Copy this file to '.env' inside backend/ for local development.
# NEVER commit real secrets or passwords to source control.
# ==============================================================================

APP_NAME=CodeSentinel
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000

# CORS Origins (JSON list format or comma-separated)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database Configuration (PostgreSQL 15+)
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+asyncpg://sentinel:secret@localhost:5432/codesentinel_dev

# Sync Database URL for Alembic Migrations
DATABASE_SYNC_URL=postgresql+psycopg2://sentinel:secret@localhost:5432/codesentinel_dev

# Redis Queue & Cache Configuration
REDIS_URL=redis://localhost:6379/0

# GitHub App Integration Credentials (Phase 6+)
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# AI Provider Configuration (Google Gemini API)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Application Security Secret Key
SECRET_KEY=dev_secret_key_change_in_production_32_bytes_min
