# ==============================================================================
# CodeSentinel Docker Ignore Manifest
# Prevents unnecessary files, secrets, build artifacts, and caches from entering Docker contexts
# ==============================================================================

# Version Control & Git
.git/
.git
.gitignore
.github

# Environment Files & Secrets
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# Python & Pytest Caches
__pycache__/
**/__pycache__/
*.py[cod]
.pytest_cache/
backend/.pytest_cache
**/.pytest_cache
.mypy_cache/
**/.mypy_cache/
.ruff_cache/
**/.ruff_cache/
.coverage
.coverage.*
htmlcov/
**/coverage

# Python Virtual Environments
venv/
.venv/
env/
**/venv
**/.venv

# Node.js & Next.js Build Artifacts / Dependencies
node_modules/
frontend/node_modules/
**/node_modules/
.next/
frontend/.next/
**/.next/
out/
build/
dist/
.npm
.yarn/
.pnpm-store

# Storage & Temporary Files
storage/sources/*
!storage/sources/.gitkeep
tmp/
temp/
*.log
*.sqlite3

# IDE & OS Generated Files
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Documentation & Development Files
Dockerfile*
docker-compose*.yml
README.md
AGENTS.md
